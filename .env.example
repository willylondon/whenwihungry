# Use a dedicated development/staging Supabase project, never production for tests.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Keep the deployed Vercel origin until custom-domain setup is separately approved.
NEXT_PUBLIC_SITE_URL=https://whenwihungry.vercel.app
# Set only after the chosen Plausible domain is configured and events verified.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Disabled until the draft request migration + RLS tests and monitoring are approved.
REVIEW_REQUESTS_ENABLED=false
